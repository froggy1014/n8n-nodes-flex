{
  "name": "n8n-nodes-flex",
  "version": "0.3.0",
  "description": "n8n community node for flex Open API (flex.team HR platform)",
  "keywords": [
    "n8n-community-node-package",
    "flex",
    "flex.team",
    "hr"
  ],
  "license": "MIT",
  "homepage": "https://developers.flex.team",
  "author": {
    "name": "froggy1014"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && npm run copy:icons && npm run copy:mocks && npm run copy:codex",
    "copy:icons": "mkdir -p dist/nodes/Flex dist/credentials && cp nodes/Flex/*.svg dist/nodes/Flex/ && cp credentials/*.svg dist/credentials/",
    "copy:mocks": "mkdir -p dist/nodes/Flex/mocks && cp nodes/Flex/mocks/*.json dist/nodes/Flex/mocks/",
    "copy:codex": "cp nodes/Flex/*.json dist/nodes/Flex/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FlexOpenApiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Flex/Flex.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "n8n-workflow": "*",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
